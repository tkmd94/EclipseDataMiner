<Window x:Class="EclipseDataMiner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:EclipseDataMiner"
        xmlns:models="clr-namespace:EclipseDataMiner.Models"
        Title="{Binding WindowTitle, FallbackValue='EclipseDataMiner v3.0.0 - High-Throughput Clinical ESAPI Data Mining Platform'}" 
        Height="880" Width="1180" MinHeight="700" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown"
        Background="{StaticResource BrushBackground}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>    <!-- 1. 4つのメインタブコンテンツ -->
            <RowDefinition Height="120"/>  <!-- 2. ログ出力コンソール -->
            <RowDefinition Height="Auto"/> <!-- 3. プログレスバー & 実行コントロールバー (Run / Cancel) -->
        </Grid.RowDefinitions>

        <TabControl x:Name="MainTabControl" Grid.Row="0" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}" Margin="0,0,0,10">
            <!-- Tab 1: 検索条件 & 合致プラン一覧 & 抽出対象選択 -->
            <TabItem Header="1- 📋 Plan Search">
                <Grid Margin="0,6,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

            <GroupBox Header="🔍 計画検索・絞り込み条件 (Plan Search &amp; Filter)" Margin="0,0,0,8">
                <StackPanel>
                    <!-- プリセットセレクター＆保存・説明編集バー ＆ 正規表現ヒント -->
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="5" Padding="8,6" Margin="0,0,0,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- 1行目左: Preset セレクター, Save, Delete -->
                            <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="🔖 Preset:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource BrushText}"/>
                                <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" 
                                          Text="{Binding PresetNameInput, UpdateSourceTrigger=PropertyChanged}"
                                          IsEditable="True" Width="240" Margin="0,0,6,0"
                                          DisplayMemberPath="Name"
                                          ToolTip="検索条件プリセットの選択、または名前を入力して保存"/>
                                <Button Content="💾 Save" Command="{Binding SavePresetCommand}" 
                                        Style="{StaticResource ModernButton}" Padding="10,3" Margin="0,0,4,0"
                                        ToolTip="現在の検索条件と説明文を入力した名前でプリセット保存"/>
                                <Button Content="🗑 Delete" Command="{Binding DeletePresetCommand}" 
                                        Style="{StaticResource DangerButton}" Padding="10,3" Margin="0,0,6,0"
                                        ToolTip="選択中のプリセットを削除（Presets フォルダのファイルを削除）"/>
                            </StackPanel>

                            <!-- 1行目右: ❓ Regex Hints ポップアップボタン -->
                            <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center">
                                <ToggleButton x:Name="BtnSearchRegexHints" Content="❓ Regex Hints ▾" Style="{StaticResource ModernToggleButton}" Padding="10,3"
                                              ToolTip="計画ID・患者ID・ターゲット輪郭で使える臨床正規表現のヒントとサンプルを表示"/>
                                <Popup x:Name="PopupSearchRegexHints" IsOpen="{Binding IsChecked, ElementName=BtnSearchRegexHints, Mode=TwoWay}"
                                       StaysOpen="False" PlacementTarget="{Binding ElementName=BtnSearchRegexHints}"
                                       Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade">
                                    <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6"
                                            Padding="12" Width="490" MaxHeight="420">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="16" Opacity="0.18" Direction="270" ShadowDepth="5"/>
                                        </Border.Effect>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <!-- ヘッダー -->
                                            <DockPanel Grid.Row="0" Margin="0,0,0,6" LastChildFill="False">
                                                <TextBlock Text="💡 計画検索用 正規表現チートシート (Plan Regex Hints)" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource BrushPrimary}" VerticalAlignment="Center"/>
                                                <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource ModernButton}" Padding="6,1" FontSize="11"
                                                        Click="InsertSearchSnippetButton_Click" ToolTip="閉じる"/>
                                            </DockPanel>

                                            <TextBlock Grid.Row="1" Text="Plan ID や Patient ID、Target Volume の「Regex」モードで利用できる頻出パターン一覧です。「Insert」を押すと Plan ID 欄に設定されます。"
                                                       FontSize="11" Foreground="{StaticResource BrushTextMuted}" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                            <!-- スニペット一覧 -->
                                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" MaxHeight="300">
                                                <ItemsControl ItemsSource="{Binding SearchRegexSnippets}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,0,6">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel Grid.Column="0">
                                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,8,0"/>
                                                                            <Border Background="#E0F2FE" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="3" Padding="4,1">
                                                                                <TextBlock Text="{Binding Pattern}" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="#0369A1"/>
                                                                            </Border>
                                                                        </StackPanel>
                                                                        <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#475569"/>
                                                                        <TextBlock Text="{Binding Example, StringFormat='例: {0}'}" FontSize="10" Foreground="#64748B" FontStyle="Italic"/>
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                                                                        <Button Content="Copy" Command="{Binding DataContext.CopyRegexSnippetCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                                                CommandParameter="{Binding Pattern}" Style="{StaticResource ModernButton}" Padding="6,2" FontSize="11" Margin="0,0,4,0" ToolTip="クリップボードにコピー"/>
                                                                        <Button Content="Insert" Command="{Binding DataContext.InsertSearchRegexSnippetCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                                                CommandParameter="{Binding Pattern}" Click="InsertSearchSnippetButton_Click" Style="{StaticResource PrimaryButton}" Padding="8,2" FontSize="11" ToolTip="Plan ID欄へ挿入しRegexモードに変更"/>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Grid>
                                    </Border>
                                </Popup>
                            </StackPanel>

                            <!-- 2行目: プリセット説明編集テキストボックス (Description) -->
                            <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Label Content="Description:" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{StaticResource BrushTextMuted}" Padding="0,0,8,0"/>
                                <TextBox Grid.Column="1" Text="{Binding PresetDescriptionInput, UpdateSourceTrigger=PropertyChanged}" 
                                         VerticalContentAlignment="Center" Padding="8,4"
                                         ToolTip="選択中プリセットの臨床プロトコルや適応疾患の説明文（編集して「💾 Save」で保存）"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- 1行目: Patient ID, Course ID, Logic 切替 -->
                        <Label Content="Patient ID:" Grid.Row="0" Grid.Column="0" FontWeight="SemiBold"/>
                        <Grid Grid.Row="0" Grid.Column="1" Margin="2,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding PatientIdText, UpdateSourceTrigger=PropertyChanged}" Grid.Column="0"
                                     ToolTip="カンマ区切りで複数OR検索。! または - で除外指定可能 (例: 100, 200, !QA)"/>
                            <ComboBox SelectedItem="{Binding PatientIdMatchMode}" Grid.Column="1" Width="82" Margin="4,0,0,0"
                                      ToolTip="Patient ID の一致モード (Contains: 部分一致, Exact: 完全一致, Regex: 正規表現)">
                                <models:TextMatchMode>Contains</models:TextMatchMode>
                                <models:TextMatchMode>Exact</models:TextMatchMode>
                                <models:TextMatchMode>Regex</models:TextMatchMode>
                            </ComboBox>
                        </Grid>

                        <Label Content="Course ID:" Grid.Row="0" Grid.Column="2" FontWeight="SemiBold" Margin="12,0,0,0"/>
                        <Grid Grid.Row="0" Grid.Column="3" Margin="2,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding CourseIdText, UpdateSourceTrigger=PropertyChanged}" Grid.Column="0"
                                     ToolTip="カンマ区切りで複数OR検索。! または - で除外指定可能 (例: C1, !C_Test)"/>
                            <ComboBox SelectedItem="{Binding CourseIdMatchMode}" Grid.Column="1" Width="82" Margin="4,0,0,0"
                                      ToolTip="Course ID の一致モード (Contains: 部分一致, Exact: 完全一致, Regex: 正規表現)">
                                <models:TextMatchMode>Contains</models:TextMatchMode>
                                <models:TextMatchMode>Exact</models:TextMatchMode>
                                <models:TextMatchMode>Regex</models:TextMatchMode>
                            </ComboBox>
                        </Grid>

                        <!-- セグメント風 Logic 切り替え -->
                        <Border Grid.Row="0" Grid.Column="4" Background="#F1F5F9" CornerRadius="4" Padding="4,2" Margin="12,2,0,2" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Logic:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,8,0" Foreground="{StaticResource BrushTextMuted}"/>
                                <RadioButton Content="AND" IsChecked="{Binding GlobalLogicIsAnd}" VerticalAlignment="Center" Margin="2,0" FontWeight="SemiBold"/>
                                <RadioButton Content="OR" IsChecked="{Binding GlobalLogicIsOr}" VerticalAlignment="Center" Margin="6,0,4,0" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <!-- 2行目: Plan ID, Target Volume, 承認ステータス -->
                        <Label Content="Plan ID:" Grid.Row="1" Grid.Column="0" FontWeight="SemiBold"/>
                        <Grid Grid.Row="1" Grid.Column="1" Margin="2,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding PlanIdText, UpdateSourceTrigger=PropertyChanged}" Grid.Column="0"
                                     ToolTip="カンマ区切りで複数OR検索。! または - で除外指定可能 (例: VMAT, IMRT, !QA, !Test)"/>
                            <ComboBox SelectedItem="{Binding PlanIdMatchMode}" Grid.Column="1" Width="82" Margin="4,0,0,0"
                                      ToolTip="Plan ID の一致モード (Contains: 部分一致, Exact: 完全一致, Regex: 正規表現)">
                                <models:TextMatchMode>Contains</models:TextMatchMode>
                                <models:TextMatchMode>Exact</models:TextMatchMode>
                                <models:TextMatchMode>Regex</models:TextMatchMode>
                            </ComboBox>
                        </Grid>

                        <Label Content="Target Volume:" Grid.Row="1" Grid.Column="2" FontWeight="SemiBold" Margin="12,0,0,0"/>
                        <Grid Grid.Row="1" Grid.Column="3" Margin="2,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding TargetVolumeIdText, UpdateSourceTrigger=PropertyChanged}" Grid.Column="0"
                                     ToolTip="Target Volume ID の一致検索。! または - で除外指定可能 (例: PTV, !PTV_QA)"/>
                            <ComboBox SelectedItem="{Binding TargetVolumeMatchMode}" Grid.Column="1" Width="82" Margin="4,0,0,0"
                                      ToolTip="Target Volume の一致モード (Contains: 部分一致, Exact: 完全一致, Regex: 正規表現)">
                                <models:TextMatchMode>Contains</models:TextMatchMode>
                                <models:TextMatchMode>Exact</models:TextMatchMode>
                                <models:TextMatchMode>Regex</models:TextMatchMode>
                            </ComboBox>
                        </Grid>

                        <!-- 承認ステータスフィルタ -->
                        <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.Column="4" VerticalAlignment="Center" Margin="12,2,0,2">
                            <CheckBox Content="Unapproved" IsChecked="{Binding FilterUnapproved}" Margin="0,0,8,0"/>
                            <CheckBox Content="Plan approved" IsChecked="{Binding FilterPlanApproved}" Margin="0,0,8,0"/>
                            <CheckBox Content="TRT approved" IsChecked="{Binding FilterTreatmentApproved}"/>
                        </StackPanel>

                        <!-- 3行目: 線量条件, PlanSum オプション -->
                        <Label Content="Dose/Fr [Gy]:" Grid.Row="2" Grid.Column="0" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding DosePerFractionText, UpdateSourceTrigger=PropertyChanged}" 
                                 Grid.Row="2" Grid.Column="1" Margin="2,3" 
                                 ToolTip="1回線量 (Gy)。単一値(2.0)、範囲指定(1.8-2.2 / 1.8~2.2)、不等号(&gt;=10, &lt;3)に対応"/>

                        <StackPanel Orientation="Horizontal" Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" VerticalAlignment="Center" Margin="12,0,0,0">
                            <Label Content="Fractions:" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding NumberOfFractionsText, UpdateSourceTrigger=PropertyChanged}" Width="55" Margin="2,3" 
                                     ToolTip="分割回数。単一値(39)、範囲指定(30-35)、不等号(&lt;=5, &gt;=10)に対応"/>

                            <Label Content="Total Dose [Gy]:" FontWeight="SemiBold" Margin="10,0,0,0"/>
                            <TextBox Text="{Binding TotalDoseText, UpdateSourceTrigger=PropertyChanged}" Width="70" Margin="2,3" 
                                     ToolTip="処方総線量 (Gy)。単一値(78)、範囲指定(70-80 / 70~80)、不等号(&gt;=60)に対応"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Grid.Row="2" Grid.Column="4" VerticalAlignment="Center" Margin="12,2,0,2">
                            <TextBlock Text="Dose:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource BrushTextMuted}"/>
                            <ComboBox SelectedItem="{Binding DosePresence}" Width="92" Margin="0,0,8,0"
                                      ToolTip="線量計算の有無による絞り込み (All: 全て, HasDose: 線量あり[計算済み], NoDose: 線量なし[未計算])">
                                <models:DosePresenceFilter>All</models:DosePresenceFilter>
                                <models:DosePresenceFilter>HasDose</models:DosePresenceFilter>
                                <models:DosePresenceFilter>NoDose</models:DosePresenceFilter>
                            </ComboBox>

                            <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="4" Padding="6,3">
                                <CheckBox Content="Include PlanSum" IsChecked="{Binding Options.ExportPlanSums}" 
                                          FontWeight="Bold" Foreground="#1E40AF" ToolTip="合算計画 (PlanSum) も抽出対象に含めます"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- 高度フィルタ (Machine, Energy, Technique, Date Range) 折りたたみ式パネル -->
                    <Expander Header="▾ Advanced Filters (Machine, Energy, Technique, Date Range)" 
                              Margin="0,8,0,0" IsExpanded="False"
                              Foreground="{StaticResource BrushTextMuted}" FontSize="12">
                        <Border Background="#F8FAFC" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,4,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="1.2*"/>
                                </Grid.ColumnDefinitions>

                                <!-- 1行目: 照射パラメータ (Machine ID, Energy, Technique) -->
                                <Label Content="Machine ID:" Grid.Row="0" Grid.Column="0" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding MachineFilterText, UpdateSourceTrigger=PropertyChanged}" 
                                         Grid.Row="0" Grid.Column="1" Margin="2,3" 
                                         ToolTip="治療装置ID。カンマ区切りで複数OR指定。! または - で除外指定可能 (例: TrueBeam, Clinac_iX, !QA_Linac)"/>

                                <Label Content="Energy:" Grid.Row="0" Grid.Column="2" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                <TextBox Text="{Binding EnergyFilterText, UpdateSourceTrigger=PropertyChanged}" 
                                         Grid.Row="0" Grid.Column="3" Margin="2,3" 
                                         ToolTip="照射エネルギー。カンマ区切りで複数OR指定。! または - で除外指定可能 (例: 6X, 10X, !6FFF)"/>

                                <Label Content="Technique:" Grid.Row="0" Grid.Column="4" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                <TextBox Text="{Binding TechniqueFilterText, UpdateSourceTrigger=PropertyChanged}" 
                                         Grid.Row="0" Grid.Column="5" Margin="2,3" 
                                         ToolTip="照射手法・MLC技術。カンマ区切りで複数OR指定。! または - で除外指定可能 (例: ARC, STATIC, !SRS)"/>

                                <!-- 2行目: 日付範囲フィルタ (Date Target, From, To, Clear) -->
                                <Label Content="Date Target:" Grid.Row="1" Grid.Column="0" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,6,0,0"/>
                                <ComboBox ItemsSource="{Binding DateTargetOptions}" SelectedItem="{Binding DateTarget}"
                                          Grid.Row="1" Grid.Column="1" Margin="2,9,2,3" VerticalAlignment="Center"
                                          ToolTip="日付フィルタの判定対象日付"/>

                                <Label Content="Date Range:" Grid.Row="1" Grid.Column="2" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,6,0,0"/>
                                <Grid Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="3" Margin="2,6,0,0" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <DatePicker SelectedDate="{Binding DateFrom, Mode=TwoWay}" Grid.Column="0"
                                                ToolTip="開始日 (From: この日以降)"/>
                                    <TextBlock Text="〜" Grid.Column="1" VerticalAlignment="Center" Margin="6,0" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}"/>
                                    <DatePicker SelectedDate="{Binding DateTo, Mode=TwoWay}" Grid.Column="2"
                                                ToolTip="終了日 (To: この日以前)"/>
                                    <Button Content="✕ Clear" Command="{Binding ClearDatesCommand}" Grid.Column="3"
                                            Style="{StaticResource ModernButton}" Padding="8,2" Margin="8,0,0,0"
                                            ToolTip="日付範囲の指定をクリア"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </Expander>

                    <!-- 検索実行フッターバー (唯一の Search Plans 実行ポイント) -->
                    <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="5" 
                            Padding="12,7" Margin="0,8,0,0">
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right" Content="🔍 Search Plans" Command="{Binding SearchPlansCommand}" 
                                    Style="{StaticResource PrimaryButton}" Background="#0284C7" Foreground="White" BorderBrush="#0369A1" 
                                    FontWeight="Bold" Padding="22,6" FontSize="13"
                                    ToolTip="上記の条件に合致するプランを高速検索し、下部の一覧に表示します"/>
                            <TextBlock Text="💡 上記の検索条件（患者/計画/ターゲット/線量/承認/装置/手法/日付）で治療計画を高速走査し、下部のプラン一覧にプレビュー表示します。" 
                                       Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" FontSize="11.5" 
                                       TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </GroupBox>

                    <!-- 検索合致プラン一覧 & 選択操作ツールバー -->
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- ツールバー: 一括選択/解除/反転, 選択サマリー -->
                    <Border Grid.Row="0" Background="{StaticResource BrushSurface}" 
                            BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" 
                            CornerRadius="4" Padding="10,6" Margin="0,0,0,8">
                        <DockPanel LastChildFill="False">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <Button Content="Select All" Command="{Binding SelectAllPlansCommand}" 
                                        Style="{StaticResource ModernButton}" Padding="12,4" Margin="0,0,4,0"
                                        ToolTip="一覧内のすべてのプランにチェックを付けます"/>
                                <Button Content="Unselect All" Command="{Binding UnselectAllPlansCommand}" 
                                        Style="{StaticResource ModernButton}" Padding="12,4" Margin="2,0"
                                        ToolTip="すべてのプランのチェックを外します"/>
                                <Button Content="Invert" Command="{Binding InvertPlanSelectionCommand}" 
                                        Style="{StaticResource ModernButton}" Padding="12,4" Margin="2,0"
                                        ToolTip="プランの選択状態を反転します"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="4" Padding="8,3">
                                    <TextBlock Text="{Binding MatchedPlansSummaryText}" FontWeight="Bold" Foreground="#1E40AF" FontSize="11.5"/>
                                </Border>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- プラン一覧 DataGrid (検索条件全項目を表示) -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding MatchedPlans}" 
                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                              RowHeight="26" SelectionMode="Extended">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Extract" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="58"/>
                            <DataGridTextColumn Header="Patient ID" Binding="{Binding PatientId}" IsReadOnly="True" Width="105"/>
                            <DataGridTextColumn Header="Course ID" Binding="{Binding CourseId}" IsReadOnly="True" Width="95"/>
                            <DataGridTextColumn Header="Plan ID" Binding="{Binding PlanId}" IsReadOnly="True" Width="130"/>
                            <DataGridTextColumn Header="Target Volume" Binding="{Binding FormattedTargetVolume}" IsReadOnly="True" Width="110"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding PlanType}" IsReadOnly="True" Width="85"/>
                            <DataGridTextColumn Header="Approval Status" Binding="{Binding ApprovalStatus}" IsReadOnly="True" Width="115"/>
                            <DataGridTextColumn Header="Dose" Binding="{Binding FormattedHasDose}" IsReadOnly="True" Width="50">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Dose/Fr" Binding="{Binding FormattedDosePerFraction}" IsReadOnly="True" Width="80"/>
                            <DataGridTextColumn Header="Fractions" Binding="{Binding FormattedNumberOfFractions}" IsReadOnly="True" Width="65"/>
                            <DataGridTextColumn Header="Total Dose" Binding="{Binding FormattedTotalDose}" IsReadOnly="True" Width="85"/>
                            <DataGridTextColumn Header="Machine" Binding="{Binding Machine}" IsReadOnly="True" Width="110"/>
                            <DataGridTextColumn Header="Energy" Binding="{Binding Energy}" IsReadOnly="True" Width="95"/>
                            <DataGridTextColumn Header="Technique" Binding="{Binding Technique}" IsReadOnly="True" Width="110"/>
                            <DataGridTextColumn Header="Treatment Approval Date" Binding="{Binding FormattedTreatmentApprovalDate}" IsReadOnly="True" Width="150"/>
                            <DataGridTextColumn Header="Planning Approval Date" Binding="{Binding FormattedPlanningApprovalDate}" IsReadOnly="True" Width="145"/>
                            <DataGridTextColumn Header="Creation Date" Binding="{Binding FormattedCreationDate}" IsReadOnly="True" Width="105"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
                </Grid>
            </TabItem>

            <!-- Tab 2: 輪郭事前マッピング & エイリアス (2-Pane Layout) -->
            <TabItem Header="2- 📐 Structure Mapping">
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.15*" MinWidth="360"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="1.0*" MinWidth="340"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左ペイン: マッピングルール定義 (永続化ルール) -->
                    <GroupBox Grid.Column="0" Header="Mapping Rules (Rule Definitions)" Margin="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="False">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                    <Button Content="+ Add Rule" Command="{Binding AddRuleCommand}" Style="{StaticResource ModernButton}" Margin="0,0,4,0"/>
                                    <Button Content="- Delete" Command="{Binding DeleteRuleCommand}" Click="DeleteRuleButton_Click" Style="{StaticResource ModernButton}" Margin="2,0"/>
                                    <Button Content="▲ Up" Command="{Binding MoveUpRuleCommand}" Style="{StaticResource ModernButton}" Margin="6,0,2,0" ToolTip="選択ルールを上位（高優先度）に移動"/>
                                    <Button Content="▼ Down" Command="{Binding MoveDownRuleCommand}" Style="{StaticResource ModernButton}" Margin="2,0" ToolTip="選択ルールを下位（低優先度）に移動"/>

                                    <!-- 臨床正規表現ヒントポップアップ -->
                                    <ToggleButton x:Name="BtnRegexHints" Content="❓ Regex Hints ▾" Style="{StaticResource ModernToggleButton}" Margin="8,0,2,0" 
                                                  ToolTip="臨床用正規表現のスニペット一覧とヒントを表示"/>
                                    <Popup x:Name="PopupRegexHints" IsOpen="{Binding IsChecked, ElementName=BtnRegexHints, Mode=TwoWay}"
                                           StaysOpen="False" PlacementTarget="{Binding ElementName=BtnRegexHints}"
                                           Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade">
                                        <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6"
                                                Padding="12" Width="480" MaxHeight="450">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="16" Opacity="0.18" Direction="270" ShadowDepth="5"/>
                                            </Border.Effect>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>

                                                <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                                    <TextBlock Text="💡 Clinical Regex Snippets (頻出パターン集)" FontWeight="Bold" FontSize="13" Foreground="{StaticResource BrushTextPrimary}"/>
                                                    <Button DockPanel.Dock="Right" Content="✕" Click="CloseRegexHintsPopup_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" FontWeight="Bold" Foreground="#94A3B8" Padding="4,0" VerticalAlignment="Center"/>
                                                </DockPanel>
                                                <TextBlock Grid.Row="1" Text="「Insert」を押すと選択中ルールのパターンに挿入され、Match Mode が自動的に Regex に切り替わります。" 
                                                           FontSize="11" Foreground="{StaticResource BrushTextMuted}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                                                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                                    <ItemsControl ItemsSource="{Binding RegexSnippets}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,0,6">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <StackPanel Grid.Column="0">
                                                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,8,0"/>
                                                                                <Border Background="#E0F2FE" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="3" Padding="4,1">
                                                                                    <TextBlock Text="{Binding Pattern}" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="#0369A1"/>
                                                                                </Border>
                                                                            </StackPanel>
                                                                            <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#475569"/>
                                                                            <TextBlock Text="{Binding Example, StringFormat='例: {0}'}" FontSize="10" Foreground="#64748B" FontStyle="Italic"/>
                                                                        </StackPanel>
                                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                                                                            <Button Content="Copy" Command="{Binding DataContext.CopyRegexSnippetCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                                                    CommandParameter="{Binding Pattern}" Style="{StaticResource ModernButton}" Padding="6,2" FontSize="11" Margin="0,0,4,0" ToolTip="クリップボードにコピー"/>
                                                                            <Button Content="Insert" Command="{Binding DataContext.InsertRegexSnippetCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                                                    CommandParameter="{Binding Pattern}" Click="InsertSnippetButton_Click" Style="{StaticResource PrimaryButton}" Padding="8,2" FontSize="11" ToolTip="選択行のパターンへ挿入しRegexモードに変更"/>
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </Grid>
                                        </Border>
                                    </Popup>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                    <Button Content="Load Rules (JSON)" Command="{Binding LoadMappingRulesCommand}" Style="{StaticResource ModernButton}" Margin="2,0"/>
                                    <Button Content="Save Rules (JSON)" Command="{Binding SaveMappingRulesCommand}" Style="{StaticResource ModernButton}" Margin="2,0,0,0"/>
                                </StackPanel>
                            </DockPanel>

                            <DataGrid x:Name="MappingRulesGrid" Grid.Row="1" ItemsSource="{Binding MappingRules}" SelectedItem="{Binding SelectedRule}"
                                      AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="False"
                                      SelectionChanged="DataGrid_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridCheckBoxColumn Header="Extract" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="55"/>
                                    <DataGridTextColumn Header="Structure ID / Pattern" Binding="{Binding Pattern, UpdateSourceTrigger=PropertyChanged}" Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="Margin" Value="4,0"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRegexError}" Value="True">
                                                        <Setter Property="Foreground" Value="#DC2626"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                        <Setter Property="ToolTip">
                                                            <Setter.Value>
                                                                <ToolTip Background="#FEF2F2" BorderBrush="#EF4444" BorderThickness="1">
                                                                    <StackPanel Orientation="Horizontal" Margin="2">
                                                                        <TextBlock Text="⚠️ " Foreground="#DC2626" FontSize="13" VerticalAlignment="Center"/>
                                                                        <TextBlock Text="Regex Syntax Error: " FontWeight="Bold" Foreground="#DC2626" VerticalAlignment="Center"/>
                                                                        <TextBlock Text="{Binding RegexErrorMessage}" Foreground="#991B1B" VerticalAlignment="Center"/>
                                                                    </StackPanel>
                                                                </ToolTip>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                        <DataGridTextColumn.EditingElementStyle>
                                            <Style TargetType="TextBox">
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="Padding" Value="2"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRegexError}" Value="True">
                                                        <Setter Property="BorderBrush" Value="#EF4444"/>
                                                        <Setter Property="BorderThickness" Value="1.5"/>
                                                        <Setter Property="Background" Value="#FEF2F2"/>
                                                        <Setter Property="ToolTip">
                                                            <Setter.Value>
                                                                <ToolTip Background="#FEF2F2" BorderBrush="#EF4444" BorderThickness="1">
                                                                    <StackPanel Orientation="Horizontal" Margin="2">
                                                                        <TextBlock Text="⚠️ " Foreground="#DC2626" FontSize="13" VerticalAlignment="Center"/>
                                                                        <TextBlock Text="Regex Syntax Error: " FontWeight="Bold" Foreground="#DC2626" VerticalAlignment="Center"/>
                                                                        <TextBlock Text="{Binding RegexErrorMessage}" Foreground="#991B1B" VerticalAlignment="Center"/>
                                                                    </StackPanel>
                                                                </ToolTip>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGridTextColumn.EditingElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridComboBoxColumn Header="Match Mode" SelectedItemBinding="{Binding MatchMode}" Width="95">
                                        <DataGridComboBoxColumn.ItemsSource>
                                            <x:Array Type="{x:Type models:StructureMatchMode}">
                                                <models:StructureMatchMode>Exact</models:StructureMatchMode>
                                                <models:StructureMatchMode>Contains</models:StructureMatchMode>
                                                <models:StructureMatchMode>Regex</models:StructureMatchMode>
                                            </x:Array>
                                        </DataGridComboBoxColumn.ItemsSource>
                                    </DataGridComboBoxColumn>
                                    <DataGridTextColumn Header="Target Alias (統合名)" Binding="{Binding TargetAlias, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </GroupBox>

                    <!-- スプリッター (幅のドラッグ調整) -->
                    <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="#CBD5E1"/>

                    <!-- 右ペイン: 事前スキャン結果 ＆ マッピング適用プレビュー -->
                    <GroupBox Grid.Column="2" Header="Discovered Structures &amp; Mapping Preview" Margin="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,6" LastChildFill="False">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                    <Button Content="🔍 Pre-Scan Structures" Command="{Binding RunPreScanCommand}" 
                                            Style="{StaticResource PrimaryButton}" Padding="12,5" Margin="0,0,4,0"/>
                                    <Button Content="⏹ Cancel" Command="{Binding CancelCommand}" 
                                            Style="{StaticResource DangerButton}" Padding="10,5" Margin="2,0,6,0"
                                            ToolTip="実行中の事前スキャンを中止します"/>
                                    <Button Content="+ Add to Rules" Command="{Binding AddDiscoveredToRulesCommand}" 
                                            Style="{StaticResource ModernButton}" Margin="2,0" 
                                            ToolTip="選択した輪郭（または未マッピング輪郭）を左ペインのルール定義に追加します"/>
                                    <Button Content="↻ Refresh Preview" Command="{Binding RefreshPreviewCommand}" 
                                            Style="{StaticResource ModernButton}" Margin="2,0" 
                                            ToolTip="最新のルール定義をプレビューに再適用します"/>
                                </StackPanel>
                                <Border DockPanel.Dock="Right" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="12" Padding="8,2" VerticalAlignment="Center" Margin="4,0,0,0">
                                    <TextBlock Text="{Binding PreScanScopeBadgeText}" FontWeight="SemiBold" FontSize="11" Foreground="#1E40AF" VerticalAlignment="Center" ToolTip="Plan Search で選択された計画が事前スキャンの走査対象となります"/>
                                </Border>
                            </DockPanel>

                            <!-- クイックフィルタバー -->
                            <Border Grid.Row="1" Background="#F1F5F9" CornerRadius="4" Padding="6,4" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- テキスト検索 -->
                                    <TextBox Grid.Column="0" Text="{Binding DiscoveredFilterText, UpdateSourceTrigger=PropertyChanged}" 
                                             VerticalContentAlignment="Center" Margin="0,0,6,0"
                                             ToolTip="輪郭IDまたは解決先Aliasで部分一致検索（リアルタイム絞り込み）"/>

                                    <!-- ステータスフィルタ (All / Unmapped Only / Mapped Only / Excluded Only) -->
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding DiscoveredFilterStatusOptions}" 
                                              SelectedItem="{Binding DiscoveredFilterStatus}" Width="130" Margin="0,0,6,0"
                                              VerticalContentAlignment="Center" ToolTip="ステータスで絞り込み"/>

                                    <!-- フィルタクリアボタン -->
                                    <Button Grid.Column="2" Content="Clear" Command="{Binding ClearDiscoveredFilterCommand}"
                                            Style="{StaticResource ModernButton}" Padding="8,2" FontSize="11" Margin="0,0,6,0"
                                            ToolTip="フィルタを解除して全件表示に戻します"/>

                                    <!-- 絞り込み件数バッジ -->
                                    <Border Grid.Column="3" Background="#E2E8F0" CornerRadius="3" Padding="6,2" VerticalAlignment="Center">
                                        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="Showing: {0}/{1}">
                                                    <Binding Path="FilteredDiscoveredCount"/>
                                                    <Binding Path="DiscoveredStructures.Count"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </Border>
                                </Grid>
                            </Border>

                            <DataGrid Grid.Row="2" ItemsSource="{Binding DiscoveredStructuresView}" SelectedItem="{Binding SelectedDiscoveredItem}"
                                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                      ToolTip="項目をダブルクリックするとマッピングルールへ直接追加できます">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                        <EventSetter Event="MouseDoubleClick" Handler="DiscoveredRow_MouseDoubleClick"/>
                                        <Setter Property="ToolTip" Value="ダブルクリックでルールに追加"/>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Raw Structure ID" Binding="{Binding RawStructureId}" Width="*"/>
                                    <DataGridTextColumn Header="Hits" Binding="{Binding HitCount}" Width="55">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                                <Setter Property="Margin" Value="0,0,6,0"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Resolved Alias" Binding="{Binding ResolvedAlias}" Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="Foreground" Value="{StaticResource BrushPrimary}"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Status" Binding="{Binding MatchStatus}" Width="150"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- Tab 3: Dose Quality Parameters (DQP) -->
            <TabItem Header="3- 📊 Dose Quality Parameters (DQP)">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- アラートノート: 基本統計量の自動出力について -->
                    <Border Grid.Row="0" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,8">
                        <DockPanel>
                            <TextBlock Text="💡 基本統計量の自動出力:" FontWeight="Bold" Foreground="#15803D" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="全対象輪郭の Volume[cc], Max dose[Gy], Mean dose[Gy], Min dose[Gy] は自動出力されるため、個別登録は不要です。" 
                                       Foreground="#166534" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>

                    <DockPanel Grid.Row="1" Margin="0,0,0,8" LastChildFill="False">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <Button Content="+ Add DQP" Command="{Binding AddDqpCommand}" Style="{StaticResource ModernButton}" Margin="0,0,4,0"/>
                            <Button Content="- Delete" Command="{Binding DeleteDqpCommand}" Click="DeleteDqpButton_Click" Style="{StaticResource ModernButton}" Margin="2,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <Button Content="Load DQP (CSV)" Command="{Binding LoadDqpCommand}" Style="{StaticResource ModernButton}" Margin="2,0"/>
                            <Button Content="Save DQP (CSV)" Command="{Binding SaveDqpCommand}" Style="{StaticResource ModernButton}" Margin="2,0,0,0"/>
                        </StackPanel>
                    </DockPanel>

                    <DataGrid x:Name="DqpGrid" Grid.Row="2" ItemsSource="{Binding DQPList}" SelectedItem="{Binding SelectedDqp}" 
                              AutoGenerateColumns="False" CanUserDeleteRows="False"
                              SelectionChanged="DataGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Structure Name / Target Alias" Binding="{Binding structureName}" Width="220"/>
                            <DataGridComboBoxColumn Header="DQP Type" SelectedValueBinding="{Binding DQPtype}" DisplayMemberPath="Label" SelectedValuePath="Value" Width="170">
                                <DataGridComboBoxColumn.ItemsSource>
                                    <x:Array Type="{x:Type models:DQPComboBoxItem}">
                                        <models:DQPComboBoxItem Label="D (Dose at Volume)" Value="Dose"/>
                                        <models:DQPComboBoxItem Label="V (Volume at Dose)" Value="Volume"/>
                                        <models:DQPComboBoxItem Label="DC (Dose Complement)" Value="DoseComplement"/>
                                        <models:DQPComboBoxItem Label="CV (Complement Volume)" Value="ComplementVolume"/>
                                    </x:Array>
                                </DataGridComboBoxColumn.ItemsSource>
                            </DataGridComboBoxColumn>
                            <DataGridTextColumn Header="Value" Binding="{Binding DQPvalue}" Width="90"/>
                            <DataGridComboBoxColumn Header="Input Unit" SelectedValueBinding="{Binding InputUnit}" DisplayMemberPath="Label" SelectedValuePath="Value" Width="140">
                                <DataGridComboBoxColumn.ItemsSource>
                                    <x:Array Type="{x:Type models:InputUnitComboBoxItem}">
                                        <models:InputUnitComboBoxItem Label="Relative [%]" Value="Relative"/>
                                        <models:InputUnitComboBoxItem Label="Absolute [Gy / cc]" Value="Absolute"/>
                                    </x:Array>
                                </DataGridComboBoxColumn.ItemsSource>
                            </DataGridComboBoxColumn>
                            <DataGridComboBoxColumn Header="Output Unit" SelectedValueBinding="{Binding OutputUnit}" DisplayMemberPath="Label" SelectedValuePath="Value" Width="140">
                                <DataGridComboBoxColumn.ItemsSource>
                                    <x:Array Type="{x:Type models:OutputUnitComboBoxItem}">
                                        <models:OutputUnitComboBoxItem Label="Absolute [Gy / cc]" Value="Absolute"/>
                                        <models:OutputUnitComboBoxItem Label="Relative [%]" Value="Relative"/>
                                    </x:Array>
                                </DataGridComboBoxColumn.ItemsSource>
                            </DataGridComboBoxColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Tab 4: 抽出・解析オプション & 出力先ファイル設定 -->
            <TabItem Header="4- ⚙️ Extraction &amp; Analysis Options">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                    <StackPanel>
                        <!-- 出力先ファイル設定カード (最上段) -->
                        <GroupBox Header="📁 Export File Destination" Margin="0,0,0,10">
                            <Grid Margin="4,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Label Content="Output CSV File:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox Grid.Column="1" Text="{Binding OutputFilePath, Mode=TwoWay}" Padding="8,5" IsReadOnly="True"
                                         Background="#F8FAFC" BorderBrush="{StaticResource BrushCardBorder}" VerticalAlignment="Center"
                                         ToolTip="データマイニング結果を出力する CSV ファイルのフルパス"/>
                                <Button Grid.Column="2" Content="📁 Browse..." Command="{Binding SelectOutputFolderCommand}" 
                                        Style="{StaticResource ModernButton}" Padding="12,5" Margin="6,0,3,0"
                                        ToolTip="出力先フォルダおよびファイル名を選択"/>
                                <Button Grid.Column="3" Content="📂 Open Folder" Command="{Binding OpenOutputFolderCommand}" 
                                        Style="{StaticResource ModernButton}" Padding="12,5" Margin="3,0,0,0"
                                        ToolTip="出力先フォルダをエクスプローラーで開く"/>
                            </Grid>
                        </GroupBox>

                        <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 左列カード群 -->
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <GroupBox Header="Plan Metadata Extraction">
                                <WrapPanel>
                                    <CheckBox Content="Planning Approver" IsChecked="{Binding Options.ExportPlanningApprover}" Margin="6"/>
                                    <CheckBox Content="Planning Approval Date" IsChecked="{Binding Options.ExportPlanningApprovalDate}" Margin="6"/>
                                    <CheckBox Content="Calculation Model" IsChecked="{Binding Options.ExportCalculationModel}" Margin="6"/>
                                    <CheckBox Content="Normalization Mode" IsChecked="{Binding Options.ExportNormalizationMode}" Margin="6"/>
                                    <CheckBox Content="Clinical Protocol" IsChecked="{Binding Options.ExportClinicalProtocol}" Margin="6"/>
                                    <CheckBox Content="Optimization Objectives" IsChecked="{Binding Options.ExportOptimizationObjectives}" Margin="6"/>
                                </WrapPanel>
                            </GroupBox>

                            <GroupBox Header="Beam Parameters &amp; Calculation Logs">
                                <WrapPanel>
                                    <CheckBox Content="Beam MU" IsChecked="{Binding Options.ExportBeamMU}" Margin="6"/>
                                    <CheckBox Content="Machine / Energy / Technique / PlanType" IsChecked="{Binding Options.ExportBeamMachineEnergyTech}" Margin="6"/>
                                    <CheckBox Content="Calculation Log" IsChecked="{Binding Options.ExportCalculationLog}" Margin="6"/>
                                </WrapPanel>
                            </GroupBox>
                        </StackPanel>

                        <!-- 右列カード群 -->
                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <GroupBox Header="Plan Complexity Analysis">
                                <StackPanel Margin="4">
                                    <CheckBox Content="Calculate Modulation Complexity Score (MCS), Edge Metric, Leaf Travel, Arc Length" 
                                              IsChecked="{Binding Options.ExportPlanComplexity}" Margin="6" FontWeight="SemiBold"/>
                                    <TextBlock Text="※各ビームの MLC 軌跡から複雑度指標を自動算出します。" 
                                               FontSize="11" Foreground="{StaticResource BrushTextMuted}" Margin="26,0,6,6"/>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Output &amp; Privacy Format">
                                <StackPanel Margin="4">
                                    <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                                        <StackPanel>
                                            <CheckBox Content="🔒 Anonymize Patient ID (SHA-256) &amp; Redact Personal Info" 
                                                      IsChecked="{Binding Options.AnonymizeOutput}" FontWeight="Bold" Foreground="#991B1B"/>
                                            <TextBlock Text="患者IDをハッシュ化し、生年月日・承認者名を REDACTED にマスクします。" 
                                                       FontSize="11" Foreground="#B91C1C" Margin="22,2,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <CheckBox Content="🤖 Simultaneously Export JSON Lines (.jsonl)" 
                                              IsChecked="{Binding Options.ExportJsonl}" Margin="6" FontWeight="SemiBold"
                                              ToolTip="機械学習・AI 解析用の階層化 JSONL ファイルを同時出力します"/>

                                    <CheckBox Content="⚡ Bypass Structure Pre-Scan" 
                                              IsChecked="{Binding Options.BypassPreScan}" Margin="6"
                                              ToolTip="チェックをONにすると、事前の輪郭スキャン確認ダイアログをスキップし、DQPリスト等の輪郭名で直接抽出を開始します。"/>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- 2. ログ出力コンソール (Dark Terminal Style) -->
        <Border Grid.Row="1" Background="#090D16" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Margin="0,0,0,8" Padding="8,6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="4,0,4,6" LastChildFill="False">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <TextBlock Text="💻 Console Output" FontFamily="Consolas" FontSize="11.5" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <Button Content="Copy" Command="{Binding CopyLogCommand}" Style="{StaticResource ModernButton}" 
                                Background="#1E293B" Foreground="#F1F5F9" BorderBrush="#334155" Padding="8,2" FontSize="11" Margin="2,0"/>
                        <Button Content="Clear" Command="{Binding ClearLogCommand}" Style="{StaticResource ModernButton}" 
                                Background="#1E293B" Foreground="#F1F5F9" BorderBrush="#334155" Padding="8,2" FontSize="11" Margin="2,0,0,0"/>
                    </StackPanel>
                </DockPanel>

                <TextBox x:Name="ConsoleTextBox" Grid.Row="1" Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" 
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         TextChanged="ConsoleTextBox_TextChanged"
                         Style="{StaticResource DarkConsoleTextBox}"/>
            </Grid>
        </Border>

        <!-- 3. プログレスバー & 実行コントロールバー (Run Extraction / Cancel とプログレスバーを同高度に配置) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 実行・中断ボタン -->
            <StackPanel Orientation="Horizontal" Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center">
                <Button Content="▶ Run Extraction" Command="{Binding RunExtractionCommand}" 
                        Style="{StaticResource PrimaryButton}" Padding="16,6" Margin="0,0,6,0" FontSize="12.5"
                        ToolTip="選択されたプラン（または全合致プラン）の本番データ抽出を実行"/>
                <Button Content="⏹ Cancel" Command="{Binding CancelCommand}" 
                        Style="{StaticResource DangerButton}" Padding="14,6" FontSize="12.5"/>
            </StackPanel>

            <!-- プログレスバー（進捗率・ステータステキスト重ね表示） -->
            <Grid Grid.Column="1" VerticalAlignment="Center">
                <ProgressBar Value="{Binding ProgressPercentage}" Minimum="0" Maximum="100" Height="28"/>
                <DockPanel LastChildFill="False">
                    <TextBlock Text="{Binding ProgressText}" DockPanel.Dock="Left" Margin="10,0,0,0"
                               VerticalAlignment="Center" FontWeight="Bold" FontSize="11.5" Foreground="#0F172A"/>
                    <TextBlock Text="{Binding ProgressPercentage, StringFormat={}{0}%}" DockPanel.Dock="Right" Margin="0,0,10,0"
                               VerticalAlignment="Center" FontWeight="Bold" FontSize="11.5" Foreground="#0F172A"/>
                </DockPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
