<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.1" />
    </startup>
    <runtime>
        <!-- Allows execution on Windows systems where FIPS compliance policy is enabled (clinical/hospital environments) -->
        <enforceFIPSPolicy enabled="false" />
    </runtime>
</configuration>